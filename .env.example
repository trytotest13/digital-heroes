# Postgres connection string.
# Production (Supabase): Project Settings -> Database -> Connection string (URI).
# Use the "Transaction pooler" string on Vercel, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed site (used for Stripe redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Stripe test mode. If unset, the app uses a clearly-labelled
# demo checkout so the subscription flow stays fully functional.
STRIPE_SECRET_KEY=
